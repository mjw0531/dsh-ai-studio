{
  "name": "dsh-ai-studio",
  "version": "2.5.3",
  "private": true,
  "description": "Install-and-use AI Studio for DeepSeek Harness: workspace dashboard, roles, tasks, verification, decision desk, merge governance, and portable project bundles.",
  "license": "MIT",
  "main": "packages/dsh-studio/lib/index.js",
  "exports": {
    ".": "./packages/dsh-studio/lib/index.js",
    "./client": "./packages/dsh-studio/lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "packages/dsh-studio/cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "ai-studio",
    "workbench"
  ],
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "pnpm --filter dsh-ai-studio build",
    "typecheck": "pnpm --filter dsh-ai-studio typecheck",
    "test": "pnpm --filter dsh-ai-studio test",
    "check": "pnpm typecheck && pnpm test",
    "check:clean": "node tools/check-repo-clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
