{
  "name": "@ai-workbench/dsh-studio",
  "version": "0.4.0",
  "description": "Install-and-use AI workbench for DeepSeek Harness: owner dashboard, Agent dispatch, token budgets, projects, tasks, acceptance, and merge governance on an independent page.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "prepack": "pnpm build"
  }
}
